# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS builder
WORKDIR /app

ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1

COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci

COPY . .

ARG VITE_API_URL_API
ARG VITE_API_URL_SOCKET
ARG VITE_FB_APP_ID
ARG VITE_FB_APP_CONNECT
ARG VITE_CLOUDINARY_CLOUD_NAME
ARG VITE_CLOUDINARY_UPLOAD_PRESET
ARG VITE_SECRET_KEY
ENV VITE_API_URL_API=$VITE_API_URL_API \
    VITE_API_URL_SOCKET=$VITE_API_URL_SOCKET \
    VITE_FB_APP_ID=$VITE_FB_APP_ID \
    VITE_FB_APP_CONNECT=$VITE_FB_APP_CONNECT \
    VITE_CLOUDINARY_CLOUD_NAME=$VITE_CLOUDINARY_CLOUD_NAME \
    VITE_CLOUDINARY_UPLOAD_PRESET=$VITE_CLOUDINARY_UPLOAD_PRESET \
    VITE_SECRET_KEY=$VITE_SECRET_KEY

RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]